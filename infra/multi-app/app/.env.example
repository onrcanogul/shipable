# One app on a shared server. Copy to .env in this directory; never commit it.
#
# Rule of thumb: anything that identifies or authenticates THIS app must be unique on the
# server. Anything that describes the shared infrastructure is the same in every app's
# file.

# ---------------------------------------------------------------------------
# Identity of this app on the server  --  ALL UNIQUE
# ---------------------------------------------------------------------------
# Compose project name and the container name Caddy proxies to. Must match the
# reverse_proxy target in ../shared/Caddyfile: APP_NAME=app-one -> app-one-api:8080
APP_NAME=app-one

# Loopback port for SSH tunnelling to the admin API. One per app: 8081, 8082, ...
APP_LOCAL_PORT=8081

# Namespaces this app's keys in the shared Redis. Two apps sharing a prefix would read
# each other's cache and rate limit counters.
APP_CACHE_KEY_PREFIX=app-one-prod

# ---------------------------------------------------------------------------
# Secrets  --  ALL UNIQUE, no exceptions
# ---------------------------------------------------------------------------
# The one that matters most. If two apps share this, a token minted for one is accepted
# by the other - anyone with an account on the cheap app has an account on the paid one.
# Generate: openssl rand -base64 48
APP_JWT_SECRET=
# Also unique. Tokens are validated against this issuer, so it is a second line of
# defence against exactly that mistake.
APP_JWT_ISSUER=app-one
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=60d

# Unique, or one app's admin key can reconfigure another.
APP_ADMIN_ENABLED=false
# Generate: openssl rand -base64 32
APP_ADMIN_API_KEY=
APP_ADMIN_ALLOWED_IPS=

# This app's own RevenueCat project.
APP_REVENUECAT_API_KEY=
APP_REVENUECAT_API_BASE_URL=https://api.revenuecat.com
APP_REVENUECAT_WEBHOOK_SECRET=
APP_REVENUECAT_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Database  --  UNIQUE database and user, shared host
# ---------------------------------------------------------------------------
# Created by ../shared/create-app-database.sh. Separate databases, not separate schemas:
# this template names its schemas identity, billing, quota... which would collide, and a
# restore of one app must not be able to touch another.
APP_DB_URL=jdbc:postgresql://postgres:5432/app_one
APP_DB_USERNAME=app_one
APP_DB_PASSWORD=
# Lower than the single-app default of 20: every app runs its own pool against the same
# Postgres. Five apps at 10 is 50 connections.
APP_DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Shared infrastructure  --  SAME in every app's file
# ---------------------------------------------------------------------------
APP_REDIS_HOST=redis
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=
APP_REDIS_TIMEOUT=2s
APP_CACHE_ENABLED=true
APP_CACHE_DEFAULT_TTL=10m

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
APP_MEM_LIMIT=1g
APP_LOG_LEVEL=INFO

APP_APPLE_BUNDLE_IDS=
APP_GOOGLE_CLIENT_IDS=

APP_RATE_LIMIT_PERMITS=120
APP_RATE_LIMIT_WINDOW=1m
APP_MIN_VERSION=0.0.0
APP_VERSION_GATE_ENABLED=true
APP_DELETION_GRACE_PERIOD=7d
APP_CONFIG_REFRESH_INTERVAL=PT60S
APP_SETTINGS_REFRESH_INTERVAL=PT30S
