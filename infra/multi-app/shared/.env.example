# Shared infrastructure for a multi-app server.
# Copy to .env in this directory. Never commit it.

# Where Let's Encrypt sends certificate expiry warnings.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# The superuser. Each app gets its OWN database and its OWN user, created with
# create-app-database.sh - apps never connect with these credentials.
POSTGRES_SUPERUSER=postgres
# Generate: openssl rand -base64 24
POSTGRES_SUPERUSER_PASSWORD=

# Every app runs its own connection pool. With APP_DB_POOL_SIZE=10 and five apps
# that is 50, plus room for psql and pg_dump.
POSTGRES_MAX_CONNECTIONS=200

# ---------------------------------------------------------------------------
# Memory limits
# ---------------------------------------------------------------------------
# Sized for a 16 GB box running roughly five apps at 1g each:
#   5g apps + 2g postgres + 0.5g redis + 0.1g caddy = ~7.6g,
# leaving the rest as page cache, which is what Postgres wants.
POSTGRES_MEM_LIMIT=2g
REDIS_MEM_LIMIT=512m
CADDY_MEM_LIMIT=128m

# Keep maxmemory below REDIS_MEM_LIMIT: the limit is what Docker kills at, maxmemory
# is where Redis starts evicting. Redis needs headroom between the two.
REDIS_MAXMEMORY=384mb
