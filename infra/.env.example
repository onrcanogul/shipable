# Copy to infra/.env and fill in. infra/.env is gitignored and must stay that way.
#
# Nothing in this repository reads a secret from anywhere but the environment. If you find
# yourself pasting a key into a .yml file, stop - that file ends up in git history, and
# git history is forever.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=appdb
POSTGRES_USER=app
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

APP_DB_URL=jdbc:postgresql://postgres:5432/appdb
APP_DB_USERNAME=app
APP_DB_PASSWORD=change-me
APP_DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Session tokens
# ---------------------------------------------------------------------------
# At least 32 bytes. The application refuses to start with anything shorter -
# a guessable signing key means anyone can mint a token for any user.
# Generate: openssl rand -base64 48
APP_JWT_SECRET=
APP_JWT_ISSUER=app-backend
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=60d

# ---------------------------------------------------------------------------
# Sign-in providers
# ---------------------------------------------------------------------------
# Comma-separated. Every app target you ship has its own audience value, and a
# token is only accepted if its `aud` is in the matching list.
# Apple: your bundle id, e.g. com.example.myapp
APP_APPLE_BUNDLE_IDS=
# Google: the OAuth client ids. iOS, Android and web each have a different one.
APP_GOOGLE_CLIENT_IDS=

# ---------------------------------------------------------------------------
# RevenueCat
# ---------------------------------------------------------------------------
# The SECRET v2 API key from Project settings -> API keys.
# NOT the public SDK key your mobile app ships with.
APP_REVENUECAT_API_KEY=
APP_REVENUECAT_API_BASE_URL=https://api.revenuecat.com
# The Authorization header value you set on the webhook in the RevenueCat dashboard.
# This is the only thing standing between a public endpoint and a stranger granting
# themselves a subscription, so make it long and random.
# Generate: openssl rand -base64 32
APP_REVENUECAT_WEBHOOK_SECRET=
APP_REVENUECAT_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Request pipeline
# ---------------------------------------------------------------------------
APP_RATE_LIMIT_PERMITS=120
APP_RATE_LIMIT_WINDOW=1m

# ---------------------------------------------------------------------------
# Client lifecycle
# ---------------------------------------------------------------------------
APP_MIN_VERSION=0.0.0
# Set false to switch the version gate off without a deploy, if it ever misfires.
APP_VERSION_GATE_ENABLED=true
APP_DELETION_GRACE_PERIOD=7d

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
APP_PORT=8080
APP_LOG_LEVEL=INFO

# The domain Caddy gets a TLS certificate for. Must resolve to this server before
# you start Caddy, or Let's Encrypt will fail and back off.
# Use localhost for local runs - Caddy issues an internal certificate for it.
APP_DOMAIN=localhost
# Where Let's Encrypt sends expiry warnings. Ignored for localhost.
[email protected]
