# This app, on a machine that hosts other things too.
# Copy to .env in this directory; never commit it.
#
# Rule of thumb: anything that identifies or authenticates this app must be unique on the
# machine. Anything describing the infrastructure is whatever the machine already uses.
#
# See ../../docs/RUNNING-ON-A-SHARED-SERVER.md for what this app expects to find.

# ---------------------------------------------------------------------------
# How this app is addressed on the machine  --  ALL UNIQUE
# ---------------------------------------------------------------------------
# Compose project name, and the container name the reverse proxy resolves:
# APP_NAME=my-app -> my-app-api:8080
APP_NAME=my-app

# The network the proxy and database are already on. Whatever the machine calls it.
APP_SHARED_NETWORK=appnet

# Loopback port for SSH tunnelling to the admin API. Pick one nothing else uses.
APP_LOCAL_PORT=8081

# Namespaced into every key this app writes to the shared Redis, and the only thing
# keeping it out of anything else's keys.
APP_CACHE_KEY_PREFIX=my-app-prod

# ---------------------------------------------------------------------------
# Secrets  --  ALL UNIQUE, no exceptions
# ---------------------------------------------------------------------------
# The one that matters most. If anything else on this machine signs tokens with the same
# secret, a token minted there is accepted here.
# Generate: openssl rand -base64 48
APP_JWT_SECRET=
# Also unique. Tokens are validated against this issuer, so it is a second line of
# defence against exactly that mistake.
APP_JWT_ISSUER=my-app
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=60d

# Unique to this app.
APP_ADMIN_ENABLED=false
# Generate: openssl rand -base64 32
APP_ADMIN_API_KEY=
APP_ADMIN_ALLOWED_IPS=

# This app's own RevenueCat project.
APP_REVENUECAT_API_KEY=
APP_REVENUECAT_API_BASE_URL=https://api.revenuecat.com
APP_REVENUECAT_WEBHOOK_SECRET=
APP_REVENUECAT_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Database  --  its OWN database and user, on the machine's Postgres
# ---------------------------------------------------------------------------
# A database of its own, not a schema in someone else's: this template names its schemas
# identity, billing, quota... which would collide, and a restore must not be able to
# reach another application's data. Ask whoever runs the machine to create it.
APP_DB_URL=jdbc:postgresql://postgres:5432/my_app
APP_DB_USERNAME=my_app
APP_DB_PASSWORD=
# Lower than the single-app default of 20, because this Postgres serves more than this
# app and max_connections is finite.
APP_DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Where the shared services are  --  whatever the machine already uses
# ---------------------------------------------------------------------------
APP_REDIS_HOST=redis
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=
APP_REDIS_TIMEOUT=2s
APP_CACHE_ENABLED=true
APP_CACHE_DEFAULT_TTL=10m

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
APP_MEM_LIMIT=1g
APP_LOG_LEVEL=INFO

APP_APPLE_BUNDLE_IDS=
APP_GOOGLE_CLIENT_IDS=

APP_RATE_LIMIT_PERMITS=120
APP_RATE_LIMIT_WINDOW=1m
APP_MIN_VERSION=0.0.0
APP_VERSION_GATE_ENABLED=true
APP_DELETION_GRACE_PERIOD=7d
APP_CONFIG_REFRESH_INTERVAL=PT60S
APP_SETTINGS_REFRESH_INTERVAL=PT30S
