# Copy to .env. EXPO_PUBLIC_* variables are inlined into the JavaScript bundle at build
# time, which means anyone with the .ipa or .apk can read them. Put nothing secret here.
#
# The RevenueCat keys below are the PUBLIC SDK keys, which are meant to ship in the app.
# The secret key stays on the backend.

# Simulator reaches the host machine differently per platform:
#   iOS simulator      http://localhost:8080
#   Android emulator   http://10.0.2.2:8080
#   Physical device    http://<your-lan-ip>:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# From RevenueCat -> Project settings -> API keys -> Public SDK keys.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
