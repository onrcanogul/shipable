# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

APP_DB_URL=jdbc:postgresql://postgres:5432/appdb
APP_DB_USERNAME=app
APP_DB_PASSWORD=change-me
APP_DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Session tokens
# ---------------------------------------------------------------------------
APP_JWT_SECRET=
APP_JWT_ISSUER=app-backend
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=60d

# ---------------------------------------------------------------------------
# Sign-in providers
# ---------------------------------------------------------------------------
APP_APPLE_BUNDLE_IDS=
APP_GOOGLE_CLIENT_IDS=

# ---------------------------------------------------------------------------
# RevenueCat
# ---------------------------------------------------------------------------
APP_REVENUECAT_API_KEY=
APP_REVENUECAT_API_BASE_URL=https://api.revenuecat.com
APP_REVENUECAT_WEBHOOK_SECRET=
APP_REVENUECAT_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# dev or prod. dev turns on readable logging, Swagger UI and the admin API;
# prod tightens everything and hides the API docs.
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Off by default: a fresh clone runs without a Redis container. Turn it on before
# you run a second instance - in-memory rate limiting means three replicas give
# a caller three times the limit.
APP_CACHE_ENABLED=false
APP_REDIS_HOST=redis
APP_REDIS_PORT=6379
# Leave blank for the local compose setup, where Redis is not reachable from
# outside the compose network. Set one the moment it is.
APP_REDIS_PASSWORD=
APP_REDIS_TIMEOUT=2s
# Namespaces every key, so one Redis can serve dev and prod without them reading
# each other's entries. Use something like myapp-dev / myapp-prod.
APP_CACHE_KEY_PREFIX=app
APP_CACHE_DEFAULT_TTL=10m

# ---------------------------------------------------------------------------
# Admin API
# ---------------------------------------------------------------------------
# This API can change rate limits, force every client to update and enable
# maintenance mode. It is the most dangerous surface in the application.
# Off unless you need it; when on, the app refuses to start without a real key.
APP_ADMIN_ENABLED=false
# At least 32 characters. Generate: openssl rand -base64 32
APP_ADMIN_API_KEY=
# Optional second lock: comma-separated IPs or CIDR ranges. Empty means "any
# address with the key". Worth setting to your own IP in production.
APP_ADMIN_ALLOWED_IPS=

# How quickly an admin change reaches the other instances.
APP_CONFIG_REFRESH_INTERVAL=PT60S
APP_SETTINGS_REFRESH_INTERVAL=PT30S

# ---------------------------------------------------------------------------
# Request pipeline
# ---------------------------------------------------------------------------
APP_RATE_LIMIT_PERMITS=120
APP_RATE_LIMIT_WINDOW=1m

# ---------------------------------------------------------------------------
# Client lifecycle
# ---------------------------------------------------------------------------
APP_MIN_VERSION=0.0.0
APP_VERSION_GATE_ENABLED=true
APP_DELETION_GRACE_PERIOD=7d

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Port inside the container. Rarely worth changing.
APP_PORT=8080
# Port on the host, bound to loopback only. Change it when something else on the machine
# already uses 8080 - for example a second app.
APP_HOST_PORT=8080
APP_LOG_LEVEL=INFO
APP_DOMAIN=localhost
# Where Let's Encrypt sends certificate expiry warnings. Only used with
# --profile standalone; ignored when APP_DOMAIN is localhost, since Caddy issues an
# internal certificate for that and never talks to Let's Encrypt.
ACME_EMAIL=
